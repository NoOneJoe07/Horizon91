# ─────────────────────────────────────────────────────────────────────
# Variables d'environnement — Groupe Supernova / HorizonSite
# Copier ce fichier en .env.local pour dev local (ne jamais committer .env.local)
# Configurer aussi dans Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────

# Formulaire de contact — Zoho Mail SMTP
# Compte expéditeur : noreply@groupesupernova.ca
# Créer le mot de passe dans Zoho Admin → Mail Accounts → noreply → Security → App Password
ZOHO_USER=noreply@groupesupernova.ca
ZOHO_PASS=mot_de_passe_app_zoho_ici

# Destinataire des formulaires de contact
CONTACT_TO=contact@groupesupernova.ca
